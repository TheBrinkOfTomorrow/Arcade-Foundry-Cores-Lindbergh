# Hummer Extreme: build defaults (CMakeLists.txt; title, controls and core version in games.toml)
set(GAME_WIDTH 1280)               # its window and mode (Change Resolution[1280,768])
set(GAME_HEIGHT 768)
set(GAME_DRIVE_BOARD ready)          # answers each packet ready (status 0)
# the region the front end can choose (its language follows), Export first
set(GAME_OPTIONS "region=export|usa|japan\\n")
